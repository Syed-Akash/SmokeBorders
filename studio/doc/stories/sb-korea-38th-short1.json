 "balls": {},
 "id": "sb-korea-38th-short1",
 "short": true,
 "film": true,
 "photosFrom": "sb-korea-38th",
 "title": "Do You Know the Man Who Split Korea Came Back to GUARD the Line? #shorts",
 "intro": {
  "mood": "tension",
  "beats": [
   {
    "say": "Do you know the man who drew the line across Korea came back, twenty one years later, to guard it?",
    "scene": {
     "shot": "card",
     "time": "1945 → 1966",
     "place": "THE 38TH PARALLEL",
     "date": "one man, both ends",
     "size": 140
    },
    "cam": {
     "lon": 127.0,
     "lat": 38.0,
     "scale": 4500
    }
   },
   {
    "say": "Tenth of August 1945. Soviet troops are pouring into northern Korea. In Washington, a colonel named Charles Bonesteel needs a line. Tonight.",
    "scene": {
     "shot": "photo",
     "img": "bonesteel",
     "move": "in",
     "caption": "Charles H. Bonesteel III"
    }
   },
   {
    "talk": [
     {
      "who": "AIDE",
      "text": "Where do we stop them?"
     },
     {
      "who": "BONE",
      "text": "North of Seoul. The thirty-eighth parallel."
     }
    ],
    "bg": {
     "shot": "set",
     "time": "night",
     "parts": [
      {
       "type": "room",
       "flag": "us",
       "window": 0.1,
       "night": true,
       "depth": 0.3
      },
      {
       "type": "table",
       "lamp": 0.5,
       "candles": 1,
       "papers": 8,
       "w": 900,
       "depth": 0.6
      }
     ]
    }
   },
   {
    "say": "He proposes it on a National Geographic map. Six days later, Moscow says yes. It is meant to be temporary.",
    "scene": {
     "shot": "map-desk",
     "push": 0.12,
     "pan": [
      60,
      40
     ]
    }
   },
   {
    "say": "Then come two Koreas, and a war that kills millions.",
    "scene": {
     "shot": "photo",
     "img": "refugees",
     "move": "out",
     "caption": "Refugees in Korea"
    }
   },
   {
    "say": "In 1966, Bonesteel is a general. And the army sends him to Korea, to command American forces along the border he proposed.",
    "scene": {
     "shot": "card",
     "time": "1966",
     "place": "SEOUL",
     "date": "Commander, US Forces Korea",
     "size": 140
    }
   },
   {
    "talk": [
     {
      "who": "GI1",
      "text": "Sir, you know this line well?"
     },
     {
      "who": "BONE66",
      "text": "Better than anyone, son.",
      "mood": "sad"
     }
    ],
    "bg": {
     "shot": "set",
     "time": "night",
     "parts": [
      {
       "type": "hills",
       "y": 0.5,
       "n": 3,
       "seed": 15,
       "depth": 0.2
      },
      {
       "type": "forest",
       "y": 0.64,
       "n": 40,
       "seed": 3,
       "h": 160,
       "depth": 0.45
      },
      {
       "type": "land",
       "kind": "snow",
       "y": 0.74,
       "depth": 0.6
      }
     ],
     "weather": "snow",
     "fx": [
      "fog"
     ]
    }
   },
   {
    "say": "Three years of raids and clashes follow. Historians call it the Korean DMZ Conflict.",
    "scene": {
     "shot": "photo",
     "img": "dmz",
     "move": "out",
     "caption": "DMZ fence, August 1968"
    }
   },
   {
    "say": "He retires in 1969. The line he drew in one night is still there.",
    "scene": {
     "shot": "card",
     "time": "TODAY",
     "place": "THE DMZ",
     "date": "still there",
     "size": 140
    },
    "pause": 1.0
   }
  ]
 },
