 "title": "Do You Know the Last French Soldier of WW1 Died Carrying a Note About SOUP? #shorts",
 "intro": {
  "mood": "tension",
  "beats": [
   {
    "say": "Do you know the last French soldier killed in the First World War was carrying a note about soup?",
    "scene": {
     "shot": "card",
     "time": "10:45",
     "place": "11 NOVEMBER 1918",
     "date": "fifteen minutes before peace"
    },
    "cam": {
     "lon": 4.85,
     "lat": 49.7,
     "scale": 9000
    }
   },
   {
    "say": "Eleventh of November 1918. The armistice is signed at five in the morning. The guns stop at eleven.",
    "scene": {
     "shot": "card",
     "time": "05:00",
     "place": "COMPIÈGNE",
     "date": "the armistice is signed"
    }
   },
   {
    "say": "Augustin Trébuchon is a messenger. He is forty, a shepherd, and he plays the accordion at village weddings.",
    "scene": {
     "shot": "set",
     "time": "day",
     "parts": [
      {
       "type": "sea",
       "y": 0.7,
       "depth": 0.3
      },
      {
       "type": "actors",
       "list": [
        {
         "preset": "poilu",
         "x": 0.45,
         "pose": "walk",
         "facing": 1,
         "h": 0.62,
         "y": 0.95,
         "prop": "paper",
         "walk": [
          0.3,
          0.55,
          0,
          5
         ]
        }
       ],
       "depth": 0.88
      }
     ],
     "weather": "rain"
    }
   },
   {
    "say": "His note tells the troops by the river Meuse that soup will be served at half past eleven. After the peace.",
    "scene": {
     "shot": "doc",
     "kind": "letter",
     "header": "~ 11 November 1918 ~ (paraphrase)",
     "lines": [
      "Soup will be served",
      "at 11:30",
      "after the peace."
     ],
     "hl": 1
    }
   },
   {
    "talk": [
     {
      "who": "POI",
      "text": "Soup at half past eleven?"
     },
     {
      "who": "POI2",
      "text": "If we live till eleven.",
      "mood": "sad"
     }
    ],
    "bg": {
     "shot": "set",
     "time": "day",
     "parts": [
      {
       "type": "land",
       "kind": "mud",
       "y": 0.72,
       "depth": 0.6
      }
     ],
     "weather": "rain"
    }
   },
   {
    "say": "At ten forty five, he is shot. Fifteen minutes before the end.",
    "scene": {
     "shot": "card",
     "time": "10:45",
     "place": "VRIGNE-MEUSE",
     "date": "Augustin Trébuchon"
    },
    "pause": 1.0
   },
   {
    "say": "And the French army, embarrassed, wrote down that he died the day before.",
    "scene": {
     "shot": "doc",
     "kind": "letter",
     "header": "French Army record (paraphrase)",
     "lines": [
      "Trébuchon, Augustin",
      "died: 10 November 1918"
     ],
     "hl": 1
    }
   }
  ]
 },
